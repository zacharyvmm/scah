<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compares scah with .NET's HTML scraping libraries, against cargo's release
    build of the native library. `just bench-csharp` builds it and runs every
    benchmark; see benches/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The library cargo built for this checkout; override for other builds. -->
    <ScahNativeLibraryDir Condition="'$(ScahNativeLibraryDir)' == ''">$(MSBuildThisFileDirectory)../../../../target/release</ScahNativeLibraryDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.9.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Scah/Scah.csproj" />
    <None Include="$(ScahNativeLibraryDir)/libscah_c.so" Condition="Exists('$(ScahNativeLibraryDir)/libscah_c.so')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ScahNativeLibraryDir)/libscah_c.dylib" Condition="Exists('$(ScahNativeLibraryDir)/libscah_c.dylib')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ScahNativeLibraryDir)/scah_c.dll" Condition="Exists('$(ScahNativeLibraryDir)/scah_c.dll')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
